---
import Button from './Button.astro';

interface Props {
	eyebrow?: string;
	heading: string;
	subtitle?: string;
	ctaHref?: string;
	ctaLabel?: string;
}

const { eyebrow, heading, subtitle, ctaHref, ctaLabel } = Astro.props;
---

<section
	class="bg-gradient-to-b from-accent-dark to-surface-white"
	aria-labelledby="hero-heading"
>
	<div
		class="mx-auto flex min-h-[28rem] max-w-content flex-col items-start justify-center px-5 py-16 text-left md:min-h-[480px] md:items-center md:px-8 md:text-center lg:px-16"
	>
		{
			eyebrow && (
				<p class="mb-3 text-sm font-normal text-body-light">{eyebrow}</p>
			)
		}
		<h1
			id="hero-heading"
			class="font-heading text-5xl font-bold leading-tight text-body-light"
		>
			{heading}
		</h1>
		{
			subtitle && (
				<p class="mt-4 max-w-2xl text-2xl font-normal text-body-light">
					{subtitle}
				</p>
			)
		}
		{
			ctaHref && ctaLabel && (
				<Button href={ctaHref} class="mt-8">
					{ctaLabel}
				</Button>
			)
		}
	</div>
</section>
