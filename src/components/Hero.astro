---
import Button from './Button.astro';

interface Props {
	eyebrow?: string;
	heading: string;
	subtitle?: string;
	ctaHref?: string;
	ctaLabel?: string;
}

const { eyebrow, heading, subtitle, ctaHref, ctaLabel } = Astro.props;
---

<section class="hero-gradient" aria-labelledby="hero-heading">
	<div
		class="mx-auto flex max-w-content flex-col items-start px-5 py-16 text-left md:items-center md:px-8 md:py-24 md:text-center lg:px-16"
	>
		{
			eyebrow && (
				<p class="mb-3 text-sm font-normal text-body-light">{eyebrow}</p>
			)
		}
		<h1
			id="hero-heading"
			class="font-heading text-[32px] font-bold leading-tight text-body-light md:text-5xl"
		>
			{heading}
		</h1>
		{
			subtitle && (
				<p class="mt-4 max-w-2xl text-xl font-normal text-body-light md:text-2xl">
					{subtitle}
				</p>
			)
		}
		{
			ctaHref && ctaLabel && (
				<Button href={ctaHref} class="mt-8">
					{ctaLabel}
				</Button>
			)
		}
	</div>
</section>

<style>
	.hero-gradient {
		background-image: linear-gradient(
			to bottom in oklab,
			var(--color-accent-dark) 0%,
			color-mix(in oklab, var(--color-accent-dark) 96%, var(--color-surface-white)) 28%,
			color-mix(in oklab, var(--color-accent-dark) 88%, var(--color-surface-white)) 45%,
			color-mix(in oklab, var(--color-accent-dark) 55%, var(--color-surface-white)) 68%,
			var(--color-surface-tint) 85%,
			var(--color-surface-white) 100%
		);
	}
</style>
