---
import Button from './Button.astro';
---

<section
	class="bg-gradient-to-b from-accent-dark to-surface-white"
	aria-labelledby="hero-heading"
>
	<div
		class="mx-auto flex min-h-[28rem] max-w-content flex-col items-start justify-center px-5 py-16 text-left md:min-h-[36rem] md:items-center md:px-8 md:text-center lg:min-h-[42rem] lg:px-16"
	>
		<p class="mb-3 text-sm font-normal text-body-light">
			BSIS Zrt. – Már 25 éve az informatikai szolgáltatásban
		</p>
		<h1
			id="hero-heading"
			class="font-heading text-5xl font-bold leading-tight text-body-light"
		>
			Az Informatikai Szolgáltató
		</h1>
		<p class="mt-4 max-w-2xl text-2xl font-normal text-body-light">
			Partnereink sikere részben a mi felelősségünk is!
		</p>
		<Button href="#kapcsolat" class="mt-8">Kapcsolat</Button>
	</div>
</section>
