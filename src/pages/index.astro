---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Certifications from '../components/Certifications.astro';
import Activities from '../components/Activities.astro';
import References from '../components/References.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
---

<Layout title="BSIS">
	<main>
		<Hero
			eyebrow="BSIS Zrt. – Már 25 éve az informatikai szolgáltatásban"
			heading="Az Informatikai Szolgáltató"
			subtitle="Partnereink sikere részben a mi felelősségünk is!"
			ctaHref="#kapcsolat"
			ctaLabel="Kapcsolat"
		/>
		<Certifications />
		<Activities />
		<References />
		<About />
		<Contact />
	</main>
</Layout>
