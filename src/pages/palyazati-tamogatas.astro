---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import GrantInfo from '../components/GrantInfo.astro';
---

<Layout
	title="Pályázati támogatás | BSIS"
	description="A BSIS Zrt. konzorciumi partnerként vesz részt a DIMOP Plusz-1.1.2/B Széchenyi Terv Plusz programban: szőlőterületek műholdadatfeldolgozás alapú termésoptimalizáló informatikai szolgáltatás kialakítása."
>
	<main>
		<Hero
			eyebrow="DIMOP Plusz-1.1.2/B"
			heading="Széchenyi Terv Plusz"
			subtitle="Dedikált K+F+I és piacra lépést támogató program a digitális gazdaság szereplőinek - Vállalati digitális K+F fejlesztések"
		/>
		<GrantInfo />
	</main>
</Layout>
