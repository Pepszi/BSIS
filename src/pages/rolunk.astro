---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import AboutFocus from '../components/AboutFocus.astro';
import AboutQuality from '../components/AboutQuality.astro';
---

<Layout
	title="Rólunk | BSIS"
	description="A BSIS Zrt. hazai szoftverfejlesztő vállalat: térinformatika, mobil- és webalkalmazások, K+F. ISO 9001 és ISO/IEC 27001 szerinti tanúsított minőség- és információbiztonság-irányítás."
>
	<main>
		<Hero
			eyebrow="BSIS Informatikai Szolgáltató és Tanácsadó Zrt."
			heading="Az MSZT új, tanúsított ügyfele"
		/>
		<AboutFocus />
		<AboutQuality />
		<section class="bg-surface-white" aria-label="Források">
			<p class="px-5 py-4 text-center text-sm font-normal leading-relaxed text-body-dark md:px-8 lg:px-16">
				<strong>Források: </strong>2025. évi auditjelentések (I. és II. szakasz), BSIS Informatikai Szolgáltató és
				Tanácsadó Zrt. Menedzsmentrendszer kézikönyve, https://www.bsis.hu/
			</p>
		</section>
	</main>
</Layout>